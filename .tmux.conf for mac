#############################
# GENERAL
#############################

# Start numbering windows at 1
set -g base-index 1

# Start pane numbering at 1
setw -g pane-base-index 1

# Don't automatically rename windows
set -g allow-rename off
set-window-option -g automatic-rename off

# Increase scrollback history
set -g history-limit 50000

# Enable mouse
set -g mouse on

# 256 colors
set -g default-terminal "tmux-256color"

# Without this tmux quantizes 24-bit color down to the 256 palette
set -as terminal-features ",*:RGB"

# Without this tmux drops the modifier on Shift+Enter, Ctrl+Enter etc.
# and apps (e.g. Claude Code) just see a plain CR
set -s extended-keys always

# Don't exit tmux when a window closes
set -g remain-on-exit off


#############################
# KEY BINDINGS
#############################

# Reload config
bind r source-file "$HOME/.config/tmux/tmux.conf" \; display-message "tmux config reloaded"

# Split panes using | and -
unbind %
unbind '"'
bind | split-window -h
bind - split-window -v

# Switch panes with Alt + arrow keys
bind -n M-Left select-pane -L
bind -n M-Right select-pane -R
bind -n M-Up select-pane -U
bind -n M-Down select-pane -D

# Switch between current and last window
bind C-b last-window


#############################
# PANE MANAGEMENT
#############################

# Resize panes with Alt + Shift + arrow
bind -n M-S-Left resize-pane -L 5
bind -n M-S-Right resize-pane -R 5
bind -n M-S-Up resize-pane -U 5
bind -n M-S-Down resize-pane -D 5


#############################
# COPY MODE
#############################

# Vi-style copy mode
setw -g mode-keys vi

# Let tmux push copies to the outer terminal via OSC 52 (also works over SSH)
set -g set-clipboard on

# Default binds v to rectangle-toggle; move it to C-v so v matches vim
bind-key -T copy-mode-vi 'v' send-keys -X begin-selection
bind-key -T copy-mode-vi 'C-v' send-keys -X rectangle-toggle

# Use tmux's copy mode with macOS clipboard
bind-key -T copy-mode-vi 'y' send-keys -X copy-pipe-and-cancel "pbcopy"

# Default drag-release only fills the tmux buffer, not the system clipboard
bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "pbcopy"


#############################
# STATUS BAR
#############################

set -g status-position bottom

set -g status-bg black
set -g status-fg white

set -g status-interval 5

set -g status-left-length 60
set -g status-left '#[fg=green](#S) #(whoami)'

set -g status-right-length 100
set -g status-right '#[fg=yellow]#(sysctl -n vm.loadavg | cut -d" " -f2-4) #[fg=white]%H:%M'

# Current window
setw -g window-status-current-format '#[fg=black,bg=white] #I:#W '

# Other windows
setw -g window-status-format '#[fg=white,bg=black] #I:#W '


#############################
# PERFORMANCE
#############################

# Faster escape sequences
set -sg escape-time 0

# Focus events
set -g focus-events on
